{
  "compilerOptions": {
    "module": "esnext",
    "target": "ES2019",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["./**/*.ts"]
}
